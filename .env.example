# Copy to .env.local for local dev. All variables are optional in dev — every
# feature below degrades to a console-log stub without its keys. On the host
# (Vercel), set the ones you want live under Project Settings -> Environment
# Variables. No value ever ships to the browser: everything here is read
# inside src/server/*.server.ts, which only runs server-side.

# Anthropic API key for the /claude chat bot (src/server/bot.server.ts) and
# the AI-written lead brief (src/server/lead.server.ts). Model is pinned in
# code (claude-haiku-4-5). Without it: bot.server.ts returns a graceful
# "unconfigured" error and lead.server.ts sends the lead email without an AI
# summary.
ANTHROPIC_API_KEY=

# Resend API key for outbound mail (src/server/email.server.ts, used by the
# contact form, newsletter signup, and lead capture). Without it: EMAIL_PROVIDER
# falls back to "stub" and mail is only console-logged, never sent.
RESEND_API_KEY=

# Selects the email transport in src/server/email.server.ts. Only "resend" is
# implemented; anything else (or unset) uses the stub transport.
# EMAIL_PROVIDER=resend

# Override the lead email's "From" header. Defaults to a sender on a domain
# already verified in Resend (see docs/adr/ for why). Only needed if that
# domain changes.
# RESEND_FROM="kamiljan.com (bot) <leads@mountaincar.is>"

# Override where lead-capture emails are delivered. Defaults to hello@kamiljan.com.
# LEAD_TO=hello@kamiljan.com
