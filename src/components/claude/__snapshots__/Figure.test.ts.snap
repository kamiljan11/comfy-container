// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`/claude figures > en > draws every figure exactly as last reviewed > arch 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 392" class="aid" role="img" aria-label="PG is a meta layer: the same gates sit under every project, whichever it is. I set the direction; proof comes back up."><defs><marker id="aiar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" class="aid-arrowhead"></path></marker></defs><rect data-explain="kamil" x="270" y="10" width="220" height="48" rx="9" class="aid-box aid-strong"></rect><text x="380" y="31" text-anchor="middle" class="aid-t">KAMIL</text><text x="380" y="47" text-anchor="middle" class="aid-s">spec · architecture · review · deploy</text><path d="M340 58 L275 92" class="aid-ln" marker-end="url(#aiar)"></path><path d="M420 58 L485 92" class="aid-ln" marker-end="url(#aiar)"></path><rect data-explain="code" x="150" y="96" width="210" height="76" rx="9" class="aid-box"></rect><text x="255" y="119" text-anchor="middle" class="aid-t">Claude Code</text><text x="255" y="138" text-anchor="middle" class="aid-s">code · CI · production</text><text x="255" y="154" text-anchor="middle" class="aid-s">GitHub · browser · mail via MCP</text><rect data-explain="cowork" x="400" y="96" width="210" height="76" rx="9" class="aid-box"></rect><text x="505" y="119" text-anchor="middle" class="aid-t">Claude Desktop (Cowork)</text><text x="505" y="138" text-anchor="middle" class="aid-s">mail · documents · research</text><text x="505" y="154" text-anchor="middle" class="aid-s">outreach · design · ops</text><path d="M362 134 L398 134" class="aid-ln" marker-end="url(#aiar)" marker-start="url(#aiar)"></path><text x="380" y="188" text-anchor="middle" class="aid-xs">same rules · same memory</text><rect data-explain="vault" x="16" y="96" width="108" height="56" rx="9" class="aid-box aid-side"></rect><text x="70" y="119" text-anchor="middle" class="aid-t">VAULT</text><text x="70" y="136" text-anchor="middle" class="aid-s">157 secrets</text><path d="M124 124 L148 124" class="aid-ln" marker-end="url(#aiar)"></path><text x="70" y="168" text-anchor="middle" class="aid-xs">keys go to the process,</text><text x="70" y="181" text-anchor="middle" class="aid-xs">never to the chat</text><rect data-explain="memory" x="636" y="96" width="108" height="56" rx="9" class="aid-box aid-side"></rect><text x="690" y="119" text-anchor="middle" class="aid-t">MEMORY</text><text x="690" y="136" text-anchor="middle" class="aid-s">2,300+ notes</text><path d="M612 124 L634 124" class="aid-ln" marker-end="url(#aiar)" marker-start="url(#aiar)"></path><text x="690" y="168" text-anchor="middle" class="aid-xs">loaded at session start,</text><text x="690" y="181" text-anchor="middle" class="aid-xs">sessions self-document</text><path d="M255 172 L255 208" class="aid-ln" marker-end="url(#aiar)"></path><path d="M505 172 L505 208" class="aid-ln" marker-end="url(#aiar)"></path><rect data-explain="gates" x="150" y="212" width="460" height="42" rx="9" class="aid-band"></rect><text x="380" y="230" text-anchor="middle" class="aid-t aid-accent">PG · GATES</text><text x="380" y="246" text-anchor="middle" class="aid-s">prompt · edit · command · stop · commit · push · CI · review · production proof</text><path d="M380 254 L380 290" class="aid-ln" marker-end="url(#aiar)"></path><rect data-explain="projects" x="150" y="294" width="460" height="44" rx="9" class="aid-box aid-prod"></rect><text x="380" y="313" text-anchor="middle" class="aid-t">EVERY PROJECT</text><text x="380" y="329" text-anchor="middle" class="aid-s">47 repositories: apps, websites, automations</text><text x="380" y="368" text-anchor="middle" class="aid-xs">PG is a meta layer: the same gates sit under every project, whichever it is. I set the direction; proof comes back up.</text></svg></div>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > cadence 1`] = `"<figure class="cad-fig"><p class="cad-status">Status on October 14: all PG routines switched off until their setup is fixed.</p><ul class="cad-grid"><li class="cad-row" data-explain="row-0"><span class="cad-name">Pull request review</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot"></span><span class="cad-dot"></span><span class="cad-dot"></span><span class="cad-dot"></span></span><span class="cad-freq">weekdays · returns</span></li><li class="cad-row" data-explain="row-1"><span class="cad-name">Health check</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span></span><span class="cad-freq">weekly · returns</span></li><li class="cad-row" data-explain="row-2"><span class="cad-name">Vulnerability watch</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span></span><span class="cad-freq">monthly · returns</span></li><li class="cad-row" data-explain="row-3"><span class="cad-name">Reviewer calibration</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span></span><span class="cad-freq">monthly · stays off</span></li><li class="cad-row" data-explain="row-4"><span class="cad-name">Look at similar projects</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span></span><span class="cad-freq">monthly · stays off</span></li><li class="cad-row" data-explain="row-5"><span class="cad-name">Model line-up check</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span></span><span class="cad-freq">monthly · stays off</span></li><li class="cad-row" data-explain="row-6"><span class="cad-name">Repository clean-up</span><span class="cad-dots" aria-hidden="true"><span class="cad-manual">⊘</span></span><span class="cad-freq">manual only</span></li></ul><figcaption class="aid-cap">Dots show the planned cadence. The three that stay off only work on PG itself, which is in maintenance mode.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > calib 1`] = `"<figure class="ch-fig"><div class="ct-wrap" tabindex="0"><table class="ct"><thead><tr><th scope="col">gate</th><th scope="col">before 1.8.0</th><th scope="col">since 1.8.0</th></tr></thead><tbody><tr><th scope="row">change size</th><td class="ct-before">400 source lines</td><td class="ct-after">1,500; one topic stays together</td></tr><tr><th scope="row">duplicated text</th><td class="ct-before">3 times in 2 files</td><td class="ct-after">6 times in 3 files; seed data ignored</td></tr><tr><th scope="row">deleting a build cache</th><td class="ct-before">blocked</td><td class="ct-after">allowed; .. and links still blocked</td></tr><tr><th scope="row">lint after an edit</th><td class="ct-before">every file</td><td class="ct-after">skips throwaway scripts outside a project</td></tr><tr><th scope="row">changelog</th><td class="ct-before">a line in every pull request</td><td class="ct-after">collected from titles at release</td></tr><tr><th scope="row">routines&#x27; scope</th><td class="ct-before">every repository</td><td class="ct-after">active ones: 12 of 47</td></tr></tbody></table></div><figcaption class="aid-cap">Thresholds recalibrated from the gate log, with test runs filtered out. Each change says how to roll it back.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > context 1`] = `"<figure class="ch-fig"><div class="ch-legend"><span><i class="ch-key ch-tone-n"></i> <!-- -->before</span><span><i class="ch-key ch-tone-a"></i> <!-- -->after</span></div><div class="ba-row"><p class="ba-label">Rules added to a follow-up prompt about code</p><div class="ba-bars"><span class="ch-track"><span class="ch-bar ch-tone-n" style="width:100%"></span></span><span class="ba-val"><span class="ba-tag">before</span> <!-- -->4.9 KB</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:18.36734693877551%"></span></span><span class="ba-val ba-after"><span class="ba-tag">after</span> <!-- -->0.9 KB</span></div></div><div class="ba-row"><p class="ba-label">Memory loaded at session start</p><div class="ba-bars"><span class="ch-track"><span class="ch-bar ch-tone-n" style="width:100%"></span></span><span class="ba-val"><span class="ba-tag">before</span> <!-- -->35 KB</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:71.42857142857143%"></span></span><span class="ba-val ba-after"><span class="ba-tag">after</span> <!-- -->25 KB</span></div></div><div class="ba-row"><p class="ba-label">Weekly limit used per request: 1M window (before) vs 400k (after)</p><div class="ba-bars"><span class="ch-track"><span class="ch-bar ch-tone-n" style="width:100%"></span></span><span class="ba-val"><span class="ba-tag">before</span> <!-- -->≈ 2.3×</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:43.47826086956522%"></span></span><span class="ba-val ba-after"><span class="ba-tag">after</span> <!-- -->1×</span></div></div><figcaption class="aid-cap">Versions 1.4.0 and 1.8.0. Kilobytes measured on the injected text; the window ratio is estimated from my transcripts.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > exceptions 1`] = `"<figure class="ch-fig"><div class="ex-grid"><div class="ex-card ch-tone-a" data-explain="level-0"><p class="ex-level">A · the agent</p><dl><dt>who decides</dt><dd>the agent fixes the problem or moves on knowingly; every pass is logged with the gate&#x27;s name</dd><dt>how long</dt><dd>one pass, logged</dd><dt>for example</dt><dd>change size, a TODO without an entry, commented-out code, repeated text, module boundaries, commit format</dd></dl></div><div class="ex-card ch-tone-n" data-explain="level-1"><p class="ex-level">B · after a review</p><dl><dt>who decides</dt><dd>the agent, but only after sub-agents reviewed the exact code and it fixed their findings</dd><dt>how long</dt><dd>15 minutes, one command, one repository</dd><dt>for example</dt><dd>deleting files, a hard reset, cleaning the repository, an unknown dependency, a personal-data column</dd></dl></div><div class="ex-card ch-tone-b" data-explain="level-2"><p class="ex-level">C · only me</p><dl><dt>who decides</dt><dd>me, by typing the phrase in the chat</dd><dt>how long</dt><dd>30 minutes, 3 uses (60 minutes for work on PG itself)</dd><dt>for example</dt><dd>changes to the gates, push to main, secrets in a commit, weaker CI, force-push, deleting a repository</dd></dl></div></div><figcaption class="aid-cap">Level C covers whatever cannot be undone or would switch off other checks. If the agent could approve changes to its own gates, A and B would mean nothing.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > limits 1`] = `"<figure class="ch-fig"><div class="lb-grid"><div class="lb-col ch-tone-a"><p class="lb-h">PG still changes when</p><ol><li><b>an incident slips through:</b> <!-- -->a real failure that a gate should have caught.</li><li><b>a tool or model changes:</b> <!-- -->an update breaks a hook or changes how the agent behaves.</li><li><b>I ask:</b> <!-- -->a deliberate decision, not a routine finding work for itself.</li></ol></div><div class="lb-col ch-tone-b"><p class="lb-h">No rule can reach</p><ol><li><b>a determined attacker:</b> <!-- -->writing a script to a file and running it beats any text rule; that is the operating system&#x27;s job.</li><li><b>the meaning of code:</b> <!-- -->a pattern check cannot tell good logic from bad; that is what review and tests are for.</li><li><b>a target that becomes the goal:</b> <!-- -->once the count of gates or green runs is the aim, it stops measuring quality.</li></ol></div></div><p class="lb-signal"><b>Stop signal:</b> <!-- -->two rounds in a row that find only edge cases never seen in real work. The parser rewrite hit it after nine.</p><figcaption class="aid-cap">Decided on October 14, 2026. The quality of the work should come from the checks that exist, not from their number.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > loop 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 290" class="aid" role="img" aria-label="The loop feeds itself: the weekly audit finds checks that stopped working, and each becomes a new scar."><defs><marker id="ailp" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" class="aid-arrowhead"></path></marker></defs><path d="M445.0733964143995 44.62864160983061 L574.7342247209322 79.37135839016939" class="aid-ln" marker-end="url(#ailp)"></path><path d="M639.8076211353316 111.72 L639.8076211353316 144.28" class="aid-ln" marker-end="url(#ailp)"></path><path d="M574.7342247209322 176.62864160983062 L445.0733964143995 211.37135839016938" class="aid-ln" marker-end="url(#ailp)"></path><path d="M314.9266035856005 211.3713583901694 L185.26577527906795 176.62864160983065" class="aid-ln" marker-end="url(#ailp)"></path><path d="M120.19237886466841 144.28000000000003 L120.19237886466844 111.72" class="aid-ln" marker-end="url(#ailp)"></path><path d="M185.2657752790679 79.37135839016939 L314.9266035856005 44.62864160983061" class="aid-ln" marker-end="url(#ailp)"></path><g data-explain="step-0"><rect x="316" y="20" width="128" height="40" rx="8" class="aid-box aid-side"></rect><text x="380" y="37" text-anchor="middle" class="aid-xs">incident or</text><text x="380" y="51" text-anchor="middle" class="aid-xs">repeated correction</text></g><g data-explain="step-1"><rect x="575.8076211353316" y="64" width="128" height="40" rx="8" class="aid-box aid-side"></rect><text x="639.8076211353316" y="81" text-anchor="middle" class="aid-xs">root cause:</text><text x="639.8076211353316" y="95" text-anchor="middle" class="aid-xs">five whys</text></g><g data-explain="step-2"><rect x="575.8076211353316" y="152" width="128" height="40" rx="8" class="aid-box aid-side"></rect><text x="639.8076211353316" y="169" text-anchor="middle" class="aid-xs">scar +</text><text x="639.8076211353316" y="183" text-anchor="middle" class="aid-xs">rule id</text></g><g data-explain="step-3"><rect x="316" y="196" width="128" height="40" rx="8" class="aid-box aid-strong"></rect><text x="380" y="213" text-anchor="middle" class="aid-xs">gate + test</text><text x="380" y="227" text-anchor="middle" class="aid-xs">that it blocks</text></g><g data-explain="step-4"><rect x="56.192378864668456" y="152.00000000000003" width="128" height="40" rx="8" class="aid-box aid-side"></rect><text x="120.19237886466846" y="169.00000000000003" text-anchor="middle" class="aid-xs">every rule has</text><text x="120.19237886466846" y="183.00000000000003" text-anchor="middle" class="aid-xs">a gate</text></g><g data-explain="step-5"><rect x="56.1923788646684" y="64" width="128" height="40" rx="8" class="aid-box aid-side"></rect><text x="120.1923788646684" y="81" text-anchor="middle" class="aid-xs">weekly</text><text x="120.1923788646684" y="95" text-anchor="middle" class="aid-xs">audit</text></g><text x="380" y="280" text-anchor="middle" class="aid-xs">The loop feeds itself: the weekly audit finds checks that stopped working, and each becomes a new scar.</text></svg></div>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > matrix 1`] = `"<figure class="ch-fig"><div class="sb-row"><p class="sb-title">Rows in every design matrix<!-- --> <span class="sb-total">62</span></p><div class="sb-bar" role="img" aria-label="Rows in every design matrix: system-design areas 37, tool layers of the stack 25"><span class="sb-seg ch-tone-a" style="width:59.7%" title="system-design areas: 37"></span><span class="sb-seg ch-tone-n" style="width:40.3%" title="tool layers of the stack: 25"></span></div><ul class="sb-keys"><li><i class="ch-key ch-tone-a"></i> <!-- -->system-design areas<!-- --> <b>37</b></li><li><i class="ch-key ch-tone-n"></i> <!-- -->tool layers of the stack<!-- --> <b>25</b></li></ul></div><div class="sb-row"><p class="sb-title">Named options in the course, before 1.5.0<!-- --> <span class="sb-total">437</span></p><div class="sb-bar" role="img" aria-label="Named options in the course, before 1.5.0: PG knew when to choose it 46 %, name only 26 %, missing 28 %"><span class="sb-seg ch-tone-a" style="width:46%" title="PG knew when to choose it: 46 %"></span><span class="sb-seg ch-tone-n" style="width:26%" title="name only: 26 %"></span><span class="sb-seg ch-tone-b" style="width:28%" title="missing: 28 %"></span></div><ul class="sb-keys"><li><i class="ch-key ch-tone-a"></i> <!-- -->PG knew when to choose it<!-- --> <b>46<!-- --> %</b></li><li><i class="ch-key ch-tone-n"></i> <!-- -->name only<!-- --> <b>26<!-- --> %</b></li><li><i class="ch-key ch-tone-b"></i> <!-- -->missing<!-- --> <b>28<!-- --> %</b></li></ul></div><div class="sb-row"><p class="sb-title">Areas the design process forced a decision in, before 1.5.0<!-- --> <span class="sb-total">37</span></p><div class="sb-bar" role="img" aria-label="Areas the design process forced a decision in, before 1.5.0: yes 15, partly 11, no 11"><span class="sb-seg ch-tone-a" style="width:40.6%" title="yes: 15"></span><span class="sb-seg ch-tone-n" style="width:29.7%" title="partly: 11"></span><span class="sb-seg ch-tone-b" style="width:29.7%" title="no: 11"></span></div><ul class="sb-keys"><li><i class="ch-key ch-tone-a"></i> <!-- -->yes<!-- --> <b>15</b></li><li><i class="ch-key ch-tone-n"></i> <!-- -->partly<!-- --> <b>11</b></li><li><i class="ch-key ch-tone-b"></i> <!-- -->no<!-- --> <b>11</b></li></ul></div><div class="sb-row"><p class="sb-title">First real run: a client app, October 6<!-- --> <span class="sb-total">37 rows</span></p><div class="sb-bar" role="img" aria-label="First real run: a client app, October 6: decision 31, not applicable 5, not now, with a signal 1"><span class="sb-seg ch-tone-a" style="width:83.8%" title="decision: 31"></span><span class="sb-seg ch-tone-n" style="width:13.5%" title="not applicable: 5"></span><span class="sb-seg ch-tone-b" style="width:2.7%" title="not now, with a signal: 1"></span></div><ul class="sb-keys"><li><i class="ch-key ch-tone-a"></i> <!-- -->decision<!-- --> <b>31</b></li><li><i class="ch-key ch-tone-n"></i> <!-- -->not applicable<!-- --> <b>5</b></li><li><i class="ch-key ch-tone-b"></i> <!-- -->not now, with a signal<!-- --> <b>1</b></li></ul></div><figcaption class="aid-cap">The audit measured the gap; the matrix closes it by making every area a row that a script checks.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > merge 1`] = `"<figure class="ch-fig"><div class="mf-head"><span class="mf-pill" data-explain="start">pull request</span><span class="mf-arrow" aria-hidden="true">→</span><span class="mf-pill mf-strong" data-explain="checks">all checks green on the current merge result</span></div><ul class="mf-grid"><li class="mf-card" data-explain="branch-0"><span class="mf-when">documentation only</span><span class="mf-needs">no review needed</span><span class="mf-chip ch-tone-a">merges on its own</span></li><li class="mf-card" data-explain="branch-1"><span class="mf-when">an ordinary code change (T1)</span><span class="mf-needs">a code review of exactly this diff</span><span class="mf-chip ch-tone-a">merges on its own</span></li><li class="mf-card" data-explain="branch-2"><span class="mf-when">shared logic (T2)</span><span class="mf-needs">code and operations reviews</span><span class="mf-chip ch-tone-a">merges on its own</span></li><li class="mf-card mf-human" data-explain="branch-3"><span class="mf-when">T3, logins, payments, migrations, dependencies, CI, agent instructions</span><span class="mf-needs">my “pozwol ALLOW_MERGE”</span><span class="mf-chip ch-tone-b">waits for my phrase</span></li></ul><figcaption class="aid-cap">On since October 4. The review must name the diff by its checksum and is valid for two hours.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > mind 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 536" class="aid" role="img" aria-label="Eight parts, one rule: nothing important exists only as written text. Every rule has an automatic check."><g data-explain="branch-0"><path d="M210 81 C 280 81, 290 264, 380 264" class="aid-ln aid-thin"></path><rect x="30" y="36" width="180" height="90" rx="9" class="aid-box aid-side"></rect><text x="120" y="56" text-anchor="middle" class="aid-t">Prompt layer</text><text x="120" y="74" text-anchor="middle" class="aid-xs">protocol on every prompt</text><text x="120" y="92" text-anchor="middle" class="aid-xs">compressed reports</text><text x="120" y="110" text-anchor="middle" class="aid-xs">skill router</text></g><g data-explain="branch-1"><path d="M210 203 C 280 203, 290 264, 380 264" class="aid-ln aid-thin"></path><rect x="30" y="158" width="180" height="90" rx="9" class="aid-box aid-side"></rect><text x="120" y="178" text-anchor="middle" class="aid-t">Event hooks</text><text x="120" y="196" text-anchor="middle" class="aid-xs">edit → lint + types</text><text x="120" y="214" text-anchor="middle" class="aid-xs">command guard</text><text x="120" y="232" text-anchor="middle" class="aid-xs">stop gate: tier from diff</text></g><g data-explain="branch-2"><path d="M210 325 C 280 325, 290 264, 380 264" class="aid-ln aid-thin"></path><rect x="30" y="280" width="180" height="90" rx="9" class="aid-box aid-side"></rect><text x="120" y="300" text-anchor="middle" class="aid-t">Git gates</text><text x="120" y="318" text-anchor="middle" class="aid-xs">secrets · base freshness</text><text x="120" y="336" text-anchor="middle" class="aid-xs">deps · duplicates · TODOs</text><text x="120" y="354" text-anchor="middle" class="aid-xs">SQL lint · boundaries</text></g><g data-explain="branch-3"><path d="M210 447 C 280 447, 290 264, 380 264" class="aid-ln aid-thin"></path><rect x="30" y="402" width="180" height="90" rx="9" class="aid-box aid-side"></rect><text x="120" y="422" text-anchor="middle" class="aid-t">Reviewer departments</text><text x="120" y="440" text-anchor="middle" class="aid-xs">code · security · data · ops</text><text x="120" y="458" text-anchor="middle" class="aid-xs">ux · product · qa</text><text x="120" y="476" text-anchor="middle" class="aid-xs">verifier · devil&#x27;s advocate</text></g><g data-explain="branch-4"><path d="M550 81 C 480 81, 470 264, 380 264" class="aid-ln aid-thin"></path><rect x="550" y="36" width="180" height="90" rx="9" class="aid-box aid-side"></rect><text x="640" y="56" text-anchor="middle" class="aid-t">Doctrine</text><text x="640" y="74" text-anchor="middle" class="aid-xs">design before code</text><text x="640" y="92" text-anchor="middle" class="aid-xs">“done” per risk tier</text><text x="640" y="110" text-anchor="middle" class="aid-xs">170 scars</text></g><g data-explain="branch-5"><path d="M550 203 C 480 203, 470 264, 380 264" class="aid-ln aid-thin"></path><rect x="550" y="158" width="180" height="90" rx="9" class="aid-box aid-side"></rect><text x="640" y="178" text-anchor="middle" class="aid-t">Repo template</text><text x="640" y="196" text-anchor="middle" class="aid-xs">CI + mutation testing</text><text x="640" y="214" text-anchor="middle" class="aid-xs">parsed boundaries</text><text x="640" y="232" text-anchor="middle" class="aid-xs">QA matrix · privacy · runbook</text></g><g data-explain="branch-6"><path d="M550 325 C 480 325, 470 264, 380 264" class="aid-ln aid-thin"></path><rect x="550" y="280" width="180" height="90" rx="9" class="aid-box aid-side"></rect><text x="640" y="300" text-anchor="middle" class="aid-t">Routines</text><text x="640" y="318" text-anchor="middle" class="aid-xs">PR reviewer · health check</text><text x="640" y="336" text-anchor="middle" class="aid-xs">vulnerability watch</text><text x="640" y="354" text-anchor="middle" class="aid-xs">paused until setup is fixed</text></g><g data-explain="branch-7"><path d="M550 447 C 480 447, 470 264, 380 264" class="aid-ln aid-thin"></path><rect x="550" y="402" width="180" height="90" rx="9" class="aid-box aid-side"></rect><text x="640" y="422" text-anchor="middle" class="aid-t">Self-tests</text><text x="640" y="440" text-anchor="middle" class="aid-xs">every gate has a test</text><text x="640" y="458" text-anchor="middle" class="aid-xs">rule → gate coverage</text><text x="640" y="476" text-anchor="middle" class="aid-xs">weekly audit</text></g><circle data-explain="center" cx="380" cy="264" r="64" class="aid-box aid-strong"></circle><text x="380" y="260" text-anchor="middle" class="aid-t aid-accent">HIGHER MIND</text><text x="380" y="278" text-anchor="middle" class="aid-xs">PG · PROMPT-GUARD</text><text x="380" y="522" text-anchor="middle" class="aid-xs">Eight parts, one rule: nothing important exists only as written text. Every rule has an automatic check.</text></svg></div>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > pipe 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 272" class="aid" role="img" aria-label="Nine checkpoints on the path of a change. I make the decisions; the checks make sure nothing is forgotten."><defs><marker id="aipr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" class="aid-arrowhead"></path></marker></defs><path d="M58 62 L672 62" class="aid-ln" marker-end="url(#aipr)"></path><rect data-explain="live" x="690" y="45" width="60" height="34" rx="8" class="aid-box aid-strong"></rect><text x="720" y="66" text-anchor="middle" class="aid-t aid-accent">LIVE</text><g data-explain="stage-0"><circle cx="78" cy="62" r="5" class="aid-node"></circle><text x="78" y="42" text-anchor="middle" class="aid-s aid-stage">prompt</text><path d="M78 70 L78 92" class="aid-ln aid-thin"></path><rect x="14.25" y="94" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="78" y="115.5" text-anchor="middle" class="aid-xs aid-chip-t">protocol injected</text></g><g data-explain="stage-1"><circle cx="149.75" cy="62" r="5" class="aid-node"></circle><text x="149.75" y="28" text-anchor="middle" class="aid-s aid-stage">edit</text><path d="M149.75 70 L149.75 144" class="aid-ln aid-thin"></path><rect x="86" y="146" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="149.75" y="167.5" text-anchor="middle" class="aid-xs aid-chip-t">lint + typecheck</text></g><g data-explain="stage-2"><circle cx="221.5" cy="62" r="5" class="aid-node"></circle><text x="221.5" y="42" text-anchor="middle" class="aid-s aid-stage">command</text><path d="M221.5 70 L221.5 92" class="aid-ln aid-thin"></path><rect x="157.75" y="94" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="221.5" y="115.5" text-anchor="middle" class="aid-xs aid-chip-t">guard + no-verify</text></g><g data-explain="stage-3"><circle cx="293.25" cy="62" r="5" class="aid-node"></circle><text x="293.25" y="28" text-anchor="middle" class="aid-s aid-stage">session end</text><path d="M293.25 70 L293.25 144" class="aid-ln aid-thin"></path><rect x="229.5" y="146" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="293.25" y="161" text-anchor="middle" class="aid-xs aid-chip-t">tier + tests</text><text x="293.25" y="174" text-anchor="middle" class="aid-xs aid-chip-t">+ reviewers</text></g><g data-explain="stage-4"><circle cx="365" cy="62" r="5" class="aid-node"></circle><text x="365" y="42" text-anchor="middle" class="aid-s aid-stage">commit</text><path d="M365 70 L365 92" class="aid-ln aid-thin"></path><rect x="301.25" y="94" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="365" y="109" text-anchor="middle" class="aid-xs aid-chip-t">message · secrets ·</text><text x="365" y="122" text-anchor="middle" class="aid-xs aid-chip-t">deps · SQL</text></g><g data-explain="stage-5"><circle cx="436.75" cy="62" r="5" class="aid-node"></circle><text x="436.75" y="28" text-anchor="middle" class="aid-s aid-stage">push</text><path d="M436.75 70 L436.75 144" class="aid-ln aid-thin"></path><rect x="373" y="146" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="436.75" y="161" text-anchor="middle" class="aid-xs aid-chip-t">no main + size</text><text x="436.75" y="174" text-anchor="middle" class="aid-xs aid-chip-t">+ cycles</text></g><g data-explain="stage-6"><circle cx="508.5" cy="62" r="5" class="aid-node"></circle><text x="508.5" y="42" text-anchor="middle" class="aid-s aid-stage">CI</text><path d="M508.5 70 L508.5 92" class="aid-ln aid-thin"></path><rect x="444.75" y="94" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="508.5" y="115.5" text-anchor="middle" class="aid-xs aid-chip-t">mutation + secrets</text></g><g data-explain="stage-7"><circle cx="580.25" cy="62" r="5" class="aid-node"></circle><text x="580.25" y="28" text-anchor="middle" class="aid-s aid-stage">merge</text><path d="M580.25 70 L580.25 144" class="aid-ln aid-thin"></path><rect x="516.5" y="146" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="580.25" y="161" text-anchor="middle" class="aid-xs aid-chip-t">current merge-ref</text><text x="580.25" y="174" text-anchor="middle" class="aid-xs aid-chip-t">only</text></g><g data-explain="stage-8"><circle cx="652" cy="62" r="5" class="aid-node"></circle><text x="652" y="42" text-anchor="middle" class="aid-s aid-stage">production</text><path d="M652 70 L652 92" class="aid-ln aid-thin"></path><rect x="588.25" y="94" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="652" y="115.5" text-anchor="middle" class="aid-xs aid-chip-t">200 from real domain</text></g><text x="380" y="208" text-anchor="middle" class="aid-xs aid-red">✕ no silent skipping: quality gates pass only with a log entry · risky steps only after a sub-agent review ·</text><text x="380" y="222" text-anchor="middle" class="aid-xs aid-red">irreversible steps and the gates themselves only after my “pozwol ALLOW_…” in the chat · a routine pull</text><text x="380" y="236" text-anchor="middle" class="aid-xs aid-red">request merges without my phrase only with proof of review</text><text x="380" y="260" text-anchor="middle" class="aid-xs">Nine checkpoints on the path of a change. I make the decisions; the checks make sure nothing is forgotten.</text></svg></div>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > release 1`] = `"<figure class="ch-fig"><ol class="rs-list"><li class="rs-step ch-tone-a"><span class="rs-n">1</span><span class="rs-title">build and tests</span><span class="rs-detail">the checks every pull request already passes</span></li><li class="rs-step ch-tone-a"><span class="rs-n">2</span><span class="rs-title">probe the preview</span><span class="rs-detail">automated requests on the paths that must never break</span></li><li class="rs-step ch-tone-a"><span class="rs-n">3</span><span class="rs-title">wait 10 minutes</span><span class="rs-detail">the new build tested outside live traffic before the domain switches</span></li><li class="rs-step ch-tone-a"><span class="rs-n">4</span><span class="rs-title">watch 15 minutes</span><span class="rs-detail">the live site checked every 30 seconds</span></li></ol><p class="rs-back">↺ <!-- -->three failed checks in a row (about a minute) bring back the last good version, once; after that, a person decides</p><figcaption class="aid-cap">Designed and reviewed; not yet rehearsed on a live project.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > review 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 236" class="aid" role="img" aria-label="Reviewers get only code that passed the scripts. A script merges findings. The verifier hunts for bugs, not confirmations."><defs><marker id="airv" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" class="aid-arrowhead"></path></marker></defs><rect data-explain="orchestrator" x="16" y="70" width="128" height="48" rx="9" class="aid-box aid-strong"></rect><text x="80" y="98" text-anchor="middle" class="aid-t">ORCHESTRATOR</text><path d="M144 94 L176 94" class="aid-ln" marker-end="url(#airv)"></path><rect data-explain="gates" x="180" y="63" width="130" height="62" rx="9" class="aid-band"></rect><text x="245" y="85" text-anchor="middle" class="aid-t aid-accent">SCRIPTS</text><text x="245" y="103" text-anchor="middle" class="aid-xs">lint · types · tests · SQL</text><g data-explain="finder-0"><path d="M310 94 L346 34" class="aid-ln aid-thin" marker-end="url(#airv)"></path><rect x="350" y="18" width="118" height="32" rx="7" class="aid-box aid-side"></rect><text x="409" y="39" text-anchor="middle" class="aid-s">code</text><path d="M468 34 L504 94" class="aid-ln aid-thin" marker-end="url(#airv)"></path></g><g data-explain="finder-1"><path d="M310 94 L346 74" class="aid-ln aid-thin" marker-end="url(#airv)"></path><rect x="350" y="58" width="118" height="32" rx="7" class="aid-box aid-side"></rect><text x="409" y="79" text-anchor="middle" class="aid-s">security</text><path d="M468 74 L504 94" class="aid-ln aid-thin" marker-end="url(#airv)"></path></g><g data-explain="finder-2"><path d="M310 94 L346 114" class="aid-ln aid-thin" marker-end="url(#airv)"></path><rect x="350" y="98" width="118" height="32" rx="7" class="aid-box aid-side"></rect><text x="409" y="119" text-anchor="middle" class="aid-s">data · ops</text><path d="M468 114 L504 94" class="aid-ln aid-thin" marker-end="url(#airv)"></path></g><g data-explain="finder-3"><path d="M310 94 L346 154" class="aid-ln aid-thin" marker-end="url(#airv)"></path><rect x="350" y="138" width="118" height="32" rx="7" class="aid-box aid-side"></rect><text x="409" y="159" text-anchor="middle" class="aid-s">ux · product · qa</text><path d="M468 154 L504 94" class="aid-ln aid-thin" marker-end="url(#airv)"></path></g><rect data-explain="aggregate" x="508" y="59" width="112" height="70" rx="9" class="aid-box"></rect><text x="564" y="81" text-anchor="middle" class="aid-t">AGGREGATE</text><text x="564" y="99" text-anchor="middle" class="aid-xs">k-of-n · needs</text><text x="564" y="113" text-anchor="middle" class="aid-xs">proof</text><path d="M564 129 L564 148" class="aid-ln" marker-end="url(#airv)"></path><rect data-explain="verifier" x="508" y="152" width="112" height="48" rx="9" class="aid-box aid-strong"></rect><text x="564" y="172" text-anchor="middle" class="aid-t">VERIFIER</text><text x="564" y="189" text-anchor="middle" class="aid-xs">reproduce or refute</text><path d="M620 94 L654 94" class="aid-ln" marker-end="url(#airv)"></path><rect data-explain="fixer" x="658" y="70" width="92" height="48" rx="9" class="aid-box aid-prod"></rect><text x="704" y="98" text-anchor="middle" class="aid-s aid-prod-t">FIX + RE-GATE</text><text x="380" y="216" text-anchor="middle" class="aid-xs aid-red">✕ <!-- -->no chat between agents · a finding without an executed command does not count</text><text x="380" y="231" text-anchor="middle" class="aid-xs">Reviewers get only code that passed the scripts. A script merges findings. The verifier hunts for bugs, not confirmations.</text></svg></div>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > rounds 1`] = `"<figure class="ch-fig"><div class="ch-legend"><span><i class="ch-key ch-tone-b"></i> <!-- -->blocking</span><span><i class="ch-key ch-tone-a"></i> <!-- -->major</span></div><div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 230" class="aid" role="img" aria-label="Release 1.7.0: findings per review round. Rounds 1 to 6 used three or four reviewers; the two final checks of the fixes used two. round 1: 1 blocking, 11 major; round 2: 1 blocking, 13 major; round 3: 0 blocking, 11 major; round 4: 0 blocking, 8 major; round 5: 0 blocking, 9 major; round 6: 0 blocking, 8 major; final checks: 1 blocking, 2 major."><line x1="60" x2="720" y1="180" y2="180" class="aid-ln"></line><g><title>round 1: 1 blocking, 11 major</title><rect x="77.71428571428572" y="49.428571428571416" width="56" height="117.85714285714286" rx="4" class="ch-svg-a"></rect><rect x="77.71428571428572" y="169.28571428571428" width="56" height="10.714285714285714" rx="4" class="ch-svg-b"></rect><text x="105.71428571428572" y="41.428571428571416" text-anchor="middle" class="aid-t">1 + 11</text><text x="105.71428571428572" y="200" text-anchor="middle" class="aid-s">round 1</text></g><g><title>round 2: 1 blocking, 13 major</title><rect x="169.14285714285717" y="28" width="56" height="139.28571428571428" rx="4" class="ch-svg-a"></rect><rect x="169.14285714285717" y="169.28571428571428" width="56" height="10.714285714285714" rx="4" class="ch-svg-b"></rect><text x="197.14285714285717" y="20" text-anchor="middle" class="aid-t">1 + 13</text><text x="197.14285714285717" y="200" text-anchor="middle" class="aid-s">round 2</text></g><g><title>round 3: 0 blocking, 11 major</title><rect x="260.57142857142856" y="62.14285714285714" width="56" height="117.85714285714286" rx="4" class="ch-svg-a"></rect><text x="288.57142857142856" y="54.14285714285714" text-anchor="middle" class="aid-t">11</text><text x="288.57142857142856" y="200" text-anchor="middle" class="aid-s">round 3</text></g><g><title>round 4: 0 blocking, 8 major</title><rect x="352" y="94.28571428571429" width="56" height="85.71428571428571" rx="4" class="ch-svg-a"></rect><text x="380" y="86.28571428571429" text-anchor="middle" class="aid-t">8</text><text x="380" y="200" text-anchor="middle" class="aid-s">round 4</text></g><g><title>round 5: 0 blocking, 9 major</title><rect x="443.42857142857144" y="83.57142857142857" width="56" height="96.42857142857143" rx="4" class="ch-svg-a"></rect><text x="471.42857142857144" y="75.57142857142857" text-anchor="middle" class="aid-t">9</text><text x="471.42857142857144" y="200" text-anchor="middle" class="aid-s">round 5</text></g><g><title>round 6: 0 blocking, 8 major</title><rect x="534.8571428571428" y="94.28571428571429" width="56" height="85.71428571428571" rx="4" class="ch-svg-a"></rect><text x="562.8571428571428" y="86.28571428571429" text-anchor="middle" class="aid-t">8</text><text x="562.8571428571428" y="200" text-anchor="middle" class="aid-s">round 6</text></g><g><title>final checks: 1 blocking, 2 major</title><rect x="626.2857142857142" y="145.85714285714286" width="56" height="21.428571428571427" rx="4" class="ch-svg-a"></rect><rect x="626.2857142857142" y="169.28571428571428" width="56" height="10.714285714285714" rx="4" class="ch-svg-b"></rect><text x="654.2857142857142" y="137.85714285714286" text-anchor="middle" class="aid-t">1 + 2</text><text x="654.2857142857142" y="200" text-anchor="middle" class="aid-s">final checks</text></g></svg></div><figcaption class="aid-cap">Release 1.7.0: findings per review round. Rounds 1 to 6 used three or four reviewers; the two final checks of the fixes used two.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > tiers 1`] = `"<figure class="ch-fig"><ol class="tl-list"><li class="tl-rung" data-explain="rung-0"><span class="tl-tier">T0</span><span class="tl-trigger">docs, copy, styles, assets</span><span class="tl-rev">script checks only</span><span class="tl-cost"><span class="tl-cost-t">review cost</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:0%"></span></span><span class="tl-cost-l">0 AI tokens</span></span></li><li class="tl-rung" data-explain="rung-1"><span class="tl-tier">T1</span><span class="tl-trigger">one isolated component or helper</span><span class="tl-rev">code review recommended</span><span class="tl-cost"><span class="tl-cost-t">review cost</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:11.11111111111111%"></span></span><span class="tl-cost-l">≈ 1 review</span></span></li><li class="tl-rung" data-explain="rung-2"><span class="tl-tier">T2</span><span class="tl-trigger">shared logic, API, dependencies, CI, &gt; 150 lines</span><span class="tl-rev">code + operations (+ UX, + data)</span><span class="tl-cost"><span class="tl-cost-t">review cost</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:44.44444444444444%"></span></span><span class="tl-cost-l">≈ 4 reviews</span></span></li><li class="tl-rung" data-explain="rung-3"><span class="tl-tier">T3</span><span class="tl-trigger">login, permissions, payments, secrets, migrations, cron, &gt; 600 lines</span><span class="tl-rev">code + security + data + operations → verifier</span><span class="tl-cost"><span class="tl-cost-t">review cost</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:100%"></span></span><span class="tl-cost-l">≈ 8–10 reviews</span></span></li></ol><figcaption class="aid-cap">The tier comes from the paths and size of the change, never from the prompt. The strongest model reviews security, data and verification at T3.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > vault 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 148" class="aid" role="img" aria-label="The agent can use a password or key it can never read."><defs><marker id="aivr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" class="aid-arrowhead"></path></marker></defs><rect data-explain="vault" x="40" y="24" width="160" height="52" rx="9" class="aid-box aid-strong"></rect><text x="120" y="46" text-anchor="middle" class="aid-t">VAULT</text><text x="120" y="63" text-anchor="middle" class="aid-s">157 secrets · self-hosted</text><path d="M200 50 L296 50" class="aid-ln" marker-end="url(#aivr)"></path><rect data-explain="bridge" x="300" y="24" width="150" height="52" rx="9" class="aid-box"></rect><text x="375" y="46" text-anchor="middle" class="aid-t">BRIDGE</text><text x="375" y="63" text-anchor="middle" class="aid-s">passes to the process</text><path d="M450 50 L546 50" class="aid-ln" marker-end="url(#aivr)"></path><rect data-explain="target" x="550" y="24" width="172" height="52" rx="9" class="aid-box"></rect><text x="636" y="46" text-anchor="middle" class="aid-t">TARGET PROCESS</text><text x="636" y="63" text-anchor="middle" class="aid-s">deploy · API call · CI</text><text data-explain="never" x="270" y="106" text-anchor="middle" class="aid-s aid-red">chat ✕</text><text data-explain="never" x="380" y="106" text-anchor="middle" class="aid-s aid-red">code ✕</text><text data-explain="never" x="490" y="106" text-anchor="middle" class="aid-s aid-red">logs ✕</text><text x="380" y="134" text-anchor="middle" class="aid-xs">The agent can use a password or key it can never read.</text></svg></div>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > versions 1`] = `"<figure class="ch-fig"><div class="vt-strip" aria-hidden="true" style="grid-template-columns:repeat(33, minmax(0, 1fr))"><span class="vt-day on" title="1"></span><span class="vt-day on" title="1"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day on" title="1"></span><span class="vt-day on" title="6">6</span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day on" title="2">2</span><span class="vt-day on" title="1"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day on" title="1"></span><span class="vt-day on" title="1"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day on" title="1"></span></div><div class="vt-ticks" aria-hidden="true"><span style="left:0%">Sep 12</span><span style="left:59.375%">Oct 1</span><span style="left:100%">Oct 14</span></div><ol class="vt-list"><li><span class="vt-date">Sep 12</span><span class="vt-v">1.0.0</span><span class="vt-theme">first public export of Prompt-Guard</span></li><li><span class="vt-date">Sep 13</span><span class="vt-v">1.1.0</span><span class="vt-theme">full English protocol, bilingual block messages</span></li><li><span class="vt-date">Sep 27</span><span class="vt-v">1.2.0</span><span class="vt-theme">rebuilt after comparing 35 open-source projects</span></li><li><span class="vt-date">Sep 28</span><span class="vt-v">1.2.1–1.2.6</span><span class="vt-theme">six fixes: test verdicts only from exit codes</span></li><li><span class="vt-date">Oct 5</span><span class="vt-v">1.3.0</span><span class="vt-theme">pull requests merge with proof of review</span></li><li><span class="vt-date">Oct 5</span><span class="vt-v">1.4.0</span><span class="vt-theme">the same rules for a smaller context bill</span></li><li><span class="vt-date">Oct 6</span><span class="vt-v">1.5.0</span><span class="vt-theme">a row for every system-design area</span></li><li><span class="vt-date">Oct 10</span><span class="vt-v">1.6.0</span><span class="vt-theme">extensions under guard, every layer of the stack</span></li><li><span class="vt-date">Oct 11</span><span class="vt-v">1.7.0</span><span class="vt-theme">architecture that stays decided, release pipeline</span></li><li><span class="vt-date">Oct 14</span><span class="vt-v">1.8.0</span><span class="vt-theme">proportionality, then maintenance mode</span></li></ol><figcaption class="aid-cap">The strip has one cell per day; a filled cell is a release, and a number means several that day.</figcaption></figure>"`;

exports[`/claude figures > en > draws every figure exactly as last reviewed > waffle 1`] = `"<figure class="ch-fig"><div class="wf-grid" role="img" aria-label="active in the last 30 days: 12, finished or resting: 34, never checked by routines: 1"><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-b"></span></div><ul class="sb-keys"><li><i class="ch-key ch-tone-a"></i> <!-- -->active in the last 30 days<!-- --> <b>12</b></li><li><i class="ch-key ch-tone-n"></i> <!-- -->finished or resting<!-- --> <b>34</b></li><li><i class="ch-key ch-tone-b"></i> <!-- -->never checked by routines<!-- --> <b>1</b></li></ul><div class="wf-facts"><span class="wf-fact"><b>33</b> <!-- -->with branch protection, 31 of them strict</span><span class="wf-fact"><b>44</b> <!-- -->with GitHub vulnerability alerts on</span></div><figcaption class="aid-cap">One square per repository, counted from GitHub on October 14, 2026.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > arch 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 392" class="aid" role="img" aria-label="PG to warstwa meta: te same bramki leżą pod każdym projektem, jakikolwiek by był. Ja wyznaczam kierunek; dowody wracają w górę."><defs><marker id="aiar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" class="aid-arrowhead"></path></marker></defs><rect data-explain="kamil" x="270" y="10" width="220" height="48" rx="9" class="aid-box aid-strong"></rect><text x="380" y="31" text-anchor="middle" class="aid-t">KAMIL</text><text x="380" y="47" text-anchor="middle" class="aid-s">spec · architektura · review · wdrożenie</text><path d="M340 58 L275 92" class="aid-ln" marker-end="url(#aiar)"></path><path d="M420 58 L485 92" class="aid-ln" marker-end="url(#aiar)"></path><rect data-explain="code" x="150" y="96" width="210" height="76" rx="9" class="aid-box"></rect><text x="255" y="119" text-anchor="middle" class="aid-t">Claude Code</text><text x="255" y="138" text-anchor="middle" class="aid-s">kod · CI · produkcja</text><text x="255" y="154" text-anchor="middle" class="aid-s">GitHub · przeglądarka · mail (MCP)</text><rect data-explain="cowork" x="400" y="96" width="210" height="76" rx="9" class="aid-box"></rect><text x="505" y="119" text-anchor="middle" class="aid-t">Claude Desktop (Cowork)</text><text x="505" y="138" text-anchor="middle" class="aid-s">poczta · dokumenty · research</text><text x="505" y="154" text-anchor="middle" class="aid-s">outreach · design · operacje</text><path d="M362 134 L398 134" class="aid-ln" marker-end="url(#aiar)" marker-start="url(#aiar)"></path><text x="380" y="188" text-anchor="middle" class="aid-xs">te same reguły · ta sama pamięć</text><rect data-explain="vault" x="16" y="96" width="108" height="56" rx="9" class="aid-box aid-side"></rect><text x="70" y="119" text-anchor="middle" class="aid-t">SEJF</text><text x="70" y="136" text-anchor="middle" class="aid-s">157 sekretów</text><path d="M124 124 L148 124" class="aid-ln" marker-end="url(#aiar)"></path><text x="70" y="168" text-anchor="middle" class="aid-xs">klucze trafiają do procesu,</text><text x="70" y="181" text-anchor="middle" class="aid-xs">nigdy do czatu</text><rect data-explain="memory" x="636" y="96" width="108" height="56" rx="9" class="aid-box aid-side"></rect><text x="690" y="119" text-anchor="middle" class="aid-t">PAMIĘĆ</text><text x="690" y="136" text-anchor="middle" class="aid-s">2300+ notatek</text><path d="M612 124 L634 124" class="aid-ln" marker-end="url(#aiar)" marker-start="url(#aiar)"></path><text x="690" y="168" text-anchor="middle" class="aid-xs">ładowana na starcie sesji,</text><text x="690" y="181" text-anchor="middle" class="aid-xs">sesje same się opisują</text><path d="M255 172 L255 208" class="aid-ln" marker-end="url(#aiar)"></path><path d="M505 172 L505 208" class="aid-ln" marker-end="url(#aiar)"></path><rect data-explain="gates" x="150" y="212" width="460" height="42" rx="9" class="aid-band"></rect><text x="380" y="230" text-anchor="middle" class="aid-t aid-accent">PG · BRAMKI</text><text x="380" y="246" text-anchor="middle" class="aid-s">prompt · edycja · komenda · stop · commit · push · CI · review · dowód z produkcji</text><path d="M380 254 L380 290" class="aid-ln" marker-end="url(#aiar)"></path><rect data-explain="projects" x="150" y="294" width="460" height="44" rx="9" class="aid-box aid-prod"></rect><text x="380" y="313" text-anchor="middle" class="aid-t">KAŻDY PROJEKT</text><text x="380" y="329" text-anchor="middle" class="aid-s">47 repozytoriów: aplikacje, strony, automatyzacje</text><text x="380" y="368" text-anchor="middle" class="aid-xs">PG to warstwa meta: te same bramki leżą pod każdym projektem, jakikolwiek by był. Ja wyznaczam kierunek; dowody wracają w górę.</text></svg></div>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > cadence 1`] = `"<figure class="cad-fig"><p class="cad-status">Stan na 14 października: wszystkie rutyny PG wyłączone do czasu naprawy ustawień.</p><ul class="cad-grid"><li class="cad-row" data-explain="row-0"><span class="cad-name">Recenzja pull requestów</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot"></span><span class="cad-dot"></span><span class="cad-dot"></span><span class="cad-dot"></span></span><span class="cad-freq">dni robocze · wraca</span></li><li class="cad-row" data-explain="row-1"><span class="cad-name">Kontrola zdrowia</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span></span><span class="cad-freq">co tydzień · wraca</span></li><li class="cad-row" data-explain="row-2"><span class="cad-name">Nadzór podatności</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span></span><span class="cad-freq">co miesiąc · wraca</span></li><li class="cad-row" data-explain="row-3"><span class="cad-name">Kalibracja recenzentów</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span></span><span class="cad-freq">co miesiąc · zostaje wył.</span></li><li class="cad-row" data-explain="row-4"><span class="cad-name">Przegląd podobnych projektów</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span></span><span class="cad-freq">co miesiąc · zostaje wył.</span></li><li class="cad-row" data-explain="row-5"><span class="cad-name">Przegląd modeli</span><span class="cad-dots" aria-hidden="true"><span class="cad-dot"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span><span class="cad-dot off"></span></span><span class="cad-freq">co miesiąc · zostaje wył.</span></li><li class="cad-row" data-explain="row-6"><span class="cad-name">Sprzątanie repozytorium</span><span class="cad-dots" aria-hidden="true"><span class="cad-manual">⊘</span></span><span class="cad-freq">tylko ręcznie</span></li></ul><figcaption class="aid-cap">Kropki pokazują planowaną częstotliwość. Trzy, które zostają wyłączone, pracują tylko nad samym PG, a ten jest w trybie utrzymania.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > calib 1`] = `"<figure class="ch-fig"><div class="ct-wrap" tabindex="0"><table class="ct"><thead><tr><th scope="col">bramka</th><th scope="col">przed 1.8.0</th><th scope="col">od 1.8.0</th></tr></thead><tbody><tr><th scope="row">rozmiar zmiany</th><td class="ct-before">400 linii kodu</td><td class="ct-after">1500; jeden temat zostaje razem</td></tr><tr><th scope="row">powtórzony tekst</th><td class="ct-before">3 razy w 2 plikach</td><td class="ct-after">6 razy w 3 plikach; dane startowe pomijane</td></tr><tr><th scope="row">kasowanie cache builda</th><td class="ct-before">zablokowane</td><td class="ct-after">dozwolone; .. i linki dalej blokowane</td></tr><tr><th scope="row">lint po edycji</th><td class="ct-before">każdy plik</td><td class="ct-after">pomija jednorazowe skrypty poza projektem</td></tr><tr><th scope="row">changelog</th><td class="ct-before">linia w każdym pull requeście</td><td class="ct-after">zbierany z tytułów przy wydaniu</td></tr><tr><th scope="row">zasięg rutyn</th><td class="ct-before">każde repozytorium</td><td class="ct-after">tylko aktywne: 12 z 47</td></tr></tbody></table></div><figcaption class="aid-cap">Progi przestrojone według dziennika bramek, z odsianymi przebiegami testów. Każda zmiana mówi, jak ją cofnąć.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > context 1`] = `"<figure class="ch-fig"><div class="ch-legend"><span><i class="ch-key ch-tone-n"></i> <!-- -->przed</span><span><i class="ch-key ch-tone-a"></i> <!-- -->po</span></div><div class="ba-row"><p class="ba-label">Zasady doklejane do kolejnego polecenia o kodzie</p><div class="ba-bars"><span class="ch-track"><span class="ch-bar ch-tone-n" style="width:100%"></span></span><span class="ba-val"><span class="ba-tag">przed</span> <!-- -->4,9 KB</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:18.36734693877551%"></span></span><span class="ba-val ba-after"><span class="ba-tag">po</span> <!-- -->0,9 KB</span></div></div><div class="ba-row"><p class="ba-label">Pamięć ładowana na starcie sesji</p><div class="ba-bars"><span class="ch-track"><span class="ch-bar ch-tone-n" style="width:100%"></span></span><span class="ba-val"><span class="ba-tag">przed</span> <!-- -->35 KB</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:71.42857142857143%"></span></span><span class="ba-val ba-after"><span class="ba-tag">po</span> <!-- -->25 KB</span></div></div><div class="ba-row"><p class="ba-label">Tygodniowy limit zużyty na zapytanie: okno 1M (przed) vs 400k (po)</p><div class="ba-bars"><span class="ch-track"><span class="ch-bar ch-tone-n" style="width:100%"></span></span><span class="ba-val"><span class="ba-tag">przed</span> <!-- -->≈ 2,3×</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:43.47826086956522%"></span></span><span class="ba-val ba-after"><span class="ba-tag">po</span> <!-- -->1×</span></div></div><figcaption class="aid-cap">Wersje 1.4.0 i 1.8.0. Kilobajty zmierzone na doklejanym tekście; proporcja okien oszacowana z moich zapisów pracy.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > exceptions 1`] = `"<figure class="ch-fig"><div class="ex-grid"><div class="ex-card ch-tone-a" data-explain="level-0"><p class="ex-level">A · agent</p><dl><dt>kto decyduje</dt><dd>agent naprawia problem albo świadomie idzie dalej; każde przejście trafia do dziennika z nazwą bramki</dd><dt>na jak długo</dt><dd>jedno przejście, zapisane</dd><dt>na przykład</dt><dd>rozmiar zmiany, TODO bez wpisu, zakomentowany kod, powtórzony tekst, granice modułów, format commita</dd></dl></div><div class="ex-card ch-tone-n" data-explain="level-1"><p class="ex-level">B · po recenzji</p><dl><dt>kto decyduje</dt><dd>agent, ale dopiero gdy podagenci zrecenzowali dokładnie ten kod, a on poprawił ich uwagi</dd><dt>na jak długo</dt><dd>15 minut, jedna komenda, jedno repozytorium</dd><dt>na przykład</dt><dd>kasowanie plików, twardy reset, czyszczenie repozytorium, nieznana zależność, kolumna z danymi osobowymi</dd></dl></div><div class="ex-card ch-tone-b" data-explain="level-2"><p class="ex-level">C · tylko ja</p><dl><dt>kto decyduje</dt><dd>ja, frazą wpisaną w czacie</dd><dt>na jak długo</dt><dd>30 minut, 3 użycia (60 minut przy pracy nad samym PG)</dd><dt>na przykład</dt><dd>zmiany w bramkach, push na main, sekrety w commicie, osłabione CI, force-push, usunięcie repozytorium</dd></dl></div></div><figcaption class="aid-cap">Poziom C obejmuje to, czego nie da się cofnąć albo co wyłączyłoby inne kontrole. Gdyby agent mógł zatwierdzać zmiany we własnych bramkach, A i B nic by nie znaczyły.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > limits 1`] = `"<figure class="ch-fig"><div class="lb-grid"><div class="lb-col ch-tone-a"><p class="lb-h">PG dalej się zmienia, gdy</p><ol><li><b>przejdzie incydent:</b> <!-- -->prawdziwa awaria, którą bramka powinna była złapać.</li><li><b>zmieni się narzędzie albo model:</b> <!-- -->aktualizacja psuje hook albo zmienia zachowanie agenta.</li><li><b>poproszę:</b> <!-- -->świadoma decyzja, a nie rutyna, która szuka sobie roboty.</li></ol></div><div class="lb-col ch-tone-b"><p class="lb-h">Żadna reguła nie sięga</p><ol><li><b>zdeterminowanego atakującego:</b> <!-- -->zapisanie skryptu do pliku i uruchomienie go bije każdą regułę tekstową; to zadanie systemu operacyjnego.</li><li><b>sensu kodu:</b> <!-- -->sprawdzanie wzorców nie odróżni dobrej logiki od złej; od tego są recenzja i testy.</li><li><b>miary, która stała się celem:</b> <!-- -->gdy celem jest liczba bramek albo zielonych przebiegów, przestaje ona mierzyć jakość.</li></ol></div></div><p class="lb-signal"><b>Sygnał stopu:</b> <!-- -->dwie rundy z rzędu, które znajdują tylko przypadki brzegowe niewidziane w prawdziwej pracy. Przepisywanie parsera trafiło na niego po dziewięciu.</p><figcaption class="aid-cap">Decyzja z 14 października 2026. Jakość pracy ma wynikać z kontroli, które istnieją, a nie z ich liczby.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > loop 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 290" class="aid" role="img" aria-label="Pętla napędza się sama: cotygodniowy audyt wyłapuje kontrole, które przestały działać, i każda z nich staje się nową blizną."><defs><marker id="ailp" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" class="aid-arrowhead"></path></marker></defs><path d="M445.0733964143995 44.62864160983061 L574.7342247209322 79.37135839016939" class="aid-ln" marker-end="url(#ailp)"></path><path d="M639.8076211353316 111.72 L639.8076211353316 144.28" class="aid-ln" marker-end="url(#ailp)"></path><path d="M574.7342247209322 176.62864160983062 L445.0733964143995 211.37135839016938" class="aid-ln" marker-end="url(#ailp)"></path><path d="M314.9266035856005 211.3713583901694 L185.26577527906795 176.62864160983065" class="aid-ln" marker-end="url(#ailp)"></path><path d="M120.19237886466841 144.28000000000003 L120.19237886466844 111.72" class="aid-ln" marker-end="url(#ailp)"></path><path d="M185.2657752790679 79.37135839016939 L314.9266035856005 44.62864160983061" class="aid-ln" marker-end="url(#ailp)"></path><g data-explain="step-0"><rect x="316" y="20" width="128" height="40" rx="8" class="aid-box aid-side"></rect><text x="380" y="37" text-anchor="middle" class="aid-xs">incydent albo</text><text x="380" y="51" text-anchor="middle" class="aid-xs">powtórzona korekta</text></g><g data-explain="step-1"><rect x="575.8076211353316" y="64" width="128" height="40" rx="8" class="aid-box aid-side"></rect><text x="639.8076211353316" y="81" text-anchor="middle" class="aid-xs">analiza przyczyn:</text><text x="639.8076211353316" y="95" text-anchor="middle" class="aid-xs">pięć „dlaczego”</text></g><g data-explain="step-2"><rect x="575.8076211353316" y="152" width="128" height="40" rx="8" class="aid-box aid-side"></rect><text x="639.8076211353316" y="169" text-anchor="middle" class="aid-xs">blizna +</text><text x="639.8076211353316" y="183" text-anchor="middle" class="aid-xs">numer reguły</text></g><g data-explain="step-3"><rect x="316" y="196" width="128" height="40" rx="8" class="aid-box aid-strong"></rect><text x="380" y="213" text-anchor="middle" class="aid-xs">bramka + test,</text><text x="380" y="227" text-anchor="middle" class="aid-xs">że blokuje</text></g><g data-explain="step-4"><rect x="56.192378864668456" y="152.00000000000003" width="128" height="40" rx="8" class="aid-box aid-side"></rect><text x="120.19237886466846" y="169.00000000000003" text-anchor="middle" class="aid-xs">każda reguła</text><text x="120.19237886466846" y="183.00000000000003" text-anchor="middle" class="aid-xs">ma bramkę</text></g><g data-explain="step-5"><rect x="56.1923788646684" y="64" width="128" height="40" rx="8" class="aid-box aid-side"></rect><text x="120.1923788646684" y="81" text-anchor="middle" class="aid-xs">cotygodniowy</text><text x="120.1923788646684" y="95" text-anchor="middle" class="aid-xs">audyt</text></g><text x="380" y="280" text-anchor="middle" class="aid-xs">Pętla napędza się sama: cotygodniowy audyt wyłapuje kontrole, które przestały działać, i każda z nich staje się nową blizną.</text></svg></div>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > matrix 1`] = `"<figure class="ch-fig"><div class="sb-row"><p class="sb-title">Wiersze w każdej macierzy projektu<!-- --> <span class="sb-total">62</span></p><div class="sb-bar" role="img" aria-label="Wiersze w każdej macierzy projektu: obszary projektowania systemów 37, warstwy narzędzi w stacku 25"><span class="sb-seg ch-tone-a" style="width:59.7%" title="obszary projektowania systemów: 37"></span><span class="sb-seg ch-tone-n" style="width:40.3%" title="warstwy narzędzi w stacku: 25"></span></div><ul class="sb-keys"><li><i class="ch-key ch-tone-a"></i> <!-- -->obszary projektowania systemów<!-- --> <b>37</b></li><li><i class="ch-key ch-tone-n"></i> <!-- -->warstwy narzędzi w stacku<!-- --> <b>25</b></li></ul></div><div class="sb-row"><p class="sb-title">Nazwane opcje z kursu, przed 1.5.0<!-- --> <span class="sb-total">437</span></p><div class="sb-bar" role="img" aria-label="Nazwane opcje z kursu, przed 1.5.0: PG wiedział, kiedy wybrać 46 %, tylko nazwa 26 %, brak 28 %"><span class="sb-seg ch-tone-a" style="width:46%" title="PG wiedział, kiedy wybrać: 46 %"></span><span class="sb-seg ch-tone-n" style="width:26%" title="tylko nazwa: 26 %"></span><span class="sb-seg ch-tone-b" style="width:28%" title="brak: 28 %"></span></div><ul class="sb-keys"><li><i class="ch-key ch-tone-a"></i> <!-- -->PG wiedział, kiedy wybrać<!-- --> <b>46<!-- --> %</b></li><li><i class="ch-key ch-tone-n"></i> <!-- -->tylko nazwa<!-- --> <b>26<!-- --> %</b></li><li><i class="ch-key ch-tone-b"></i> <!-- -->brak<!-- --> <b>28<!-- --> %</b></li></ul></div><div class="sb-row"><p class="sb-title">Obszary, w których proces wymuszał decyzję, przed 1.5.0<!-- --> <span class="sb-total">37</span></p><div class="sb-bar" role="img" aria-label="Obszary, w których proces wymuszał decyzję, przed 1.5.0: tak 15, częściowo 11, nie 11"><span class="sb-seg ch-tone-a" style="width:40.6%" title="tak: 15"></span><span class="sb-seg ch-tone-n" style="width:29.7%" title="częściowo: 11"></span><span class="sb-seg ch-tone-b" style="width:29.7%" title="nie: 11"></span></div><ul class="sb-keys"><li><i class="ch-key ch-tone-a"></i> <!-- -->tak<!-- --> <b>15</b></li><li><i class="ch-key ch-tone-n"></i> <!-- -->częściowo<!-- --> <b>11</b></li><li><i class="ch-key ch-tone-b"></i> <!-- -->nie<!-- --> <b>11</b></li></ul></div><div class="sb-row"><p class="sb-title">Pierwszy prawdziwy przebieg: aplikacja klienta, 6 października<!-- --> <span class="sb-total">37 wierszy</span></p><div class="sb-bar" role="img" aria-label="Pierwszy prawdziwy przebieg: aplikacja klienta, 6 października: decyzja 31, nie dotyczy 5, nie teraz, z sygnałem 1"><span class="sb-seg ch-tone-a" style="width:83.8%" title="decyzja: 31"></span><span class="sb-seg ch-tone-n" style="width:13.5%" title="nie dotyczy: 5"></span><span class="sb-seg ch-tone-b" style="width:2.7%" title="nie teraz, z sygnałem: 1"></span></div><ul class="sb-keys"><li><i class="ch-key ch-tone-a"></i> <!-- -->decyzja<!-- --> <b>31</b></li><li><i class="ch-key ch-tone-n"></i> <!-- -->nie dotyczy<!-- --> <b>5</b></li><li><i class="ch-key ch-tone-b"></i> <!-- -->nie teraz, z sygnałem<!-- --> <b>1</b></li></ul></div><figcaption class="aid-cap">Audyt zmierzył lukę; macierz ją zamyka, bo każdy obszar staje się wierszem, który sprawdza skrypt.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > merge 1`] = `"<figure class="ch-fig"><div class="mf-head"><span class="mf-pill" data-explain="start">pull request</span><span class="mf-arrow" aria-hidden="true">→</span><span class="mf-pill mf-strong" data-explain="checks">wszystkie kontrole zielone na aktualnym wyniku scalenia</span></div><ul class="mf-grid"><li class="mf-card" data-explain="branch-0"><span class="mf-when">sama dokumentacja</span><span class="mf-needs">recenzja niepotrzebna</span><span class="mf-chip ch-tone-a">scala się sam</span></li><li class="mf-card" data-explain="branch-1"><span class="mf-when">zwykła zmiana kodu (T1)</span><span class="mf-needs">recenzja kodu dokładnie tego diffu</span><span class="mf-chip ch-tone-a">scala się sam</span></li><li class="mf-card" data-explain="branch-2"><span class="mf-when">wspólna logika (T2)</span><span class="mf-needs">recenzja kodu i operacji</span><span class="mf-chip ch-tone-a">scala się sam</span></li><li class="mf-card mf-human" data-explain="branch-3"><span class="mf-when">T3, logowanie, płatności, migracje, zależności, CI, instrukcje agentów</span><span class="mf-needs">moje „pozwol ALLOW_MERGE”</span><span class="mf-chip ch-tone-b">czeka na moją frazę</span></li></ul><figcaption class="aid-cap">Włączone od 4 października. Recenzja musi wskazać diff po sumie kontrolnej i jest ważna dwie godziny.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > mind 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 584" class="aid" role="img" aria-label="Osiem części, jedna zasada: nic ważnego nie istnieje tylko jako tekst. Każda reguła ma automatyczną kontrolę."><g data-explain="branch-0"><path d="M210 87 C 280 87, 290 288, 380 288" class="aid-ln aid-thin"></path><rect x="30" y="36" width="180" height="102" rx="9" class="aid-box aid-side"></rect><text x="120" y="56" text-anchor="middle" class="aid-t">Warstwa promptu</text><text x="120" y="74" text-anchor="middle" class="aid-xs">protokół w każdym prompcie</text><text x="120" y="92" text-anchor="middle" class="aid-xs">skompresowane raporty</text><text x="120" y="110" text-anchor="middle" class="aid-xs">router skilli</text></g><g data-explain="branch-1"><path d="M210 221 C 280 221, 290 288, 380 288" class="aid-ln aid-thin"></path><rect x="30" y="170" width="180" height="102" rx="9" class="aid-box aid-side"></rect><text x="120" y="190" text-anchor="middle" class="aid-t">Hooki na zdarzeniach</text><text x="120" y="208" text-anchor="middle" class="aid-xs">edycja → lint + typy</text><text x="120" y="226" text-anchor="middle" class="aid-xs">strażnik komend</text><text x="120" y="244" text-anchor="middle" class="aid-xs">bramka stop: tier z diffu</text></g><g data-explain="branch-2"><path d="M210 355 C 280 355, 290 288, 380 288" class="aid-ln aid-thin"></path><rect x="30" y="304" width="180" height="102" rx="9" class="aid-box aid-side"></rect><text x="120" y="324" text-anchor="middle" class="aid-t">Bramki gita</text><text x="120" y="342" text-anchor="middle" class="aid-xs">sekrety · świeżość bazy</text><text x="120" y="360" text-anchor="middle" class="aid-xs">zależności · duplikaty · TODO</text><text x="120" y="378" text-anchor="middle" class="aid-xs">lint SQL · granice</text></g><g data-explain="branch-3"><path d="M210 489 C 280 489, 290 288, 380 288" class="aid-ln aid-thin"></path><rect x="30" y="438" width="180" height="102" rx="9" class="aid-box aid-side"></rect><text x="120" y="458" text-anchor="middle" class="aid-t">Działy recenzentów</text><text x="120" y="476" text-anchor="middle" class="aid-xs">kod · bezpieczeństwo · dane ·</text><text x="120" y="488" text-anchor="middle" class="aid-xs">ops</text><text x="120" y="506" text-anchor="middle" class="aid-xs">ux · produkt · qa</text><text x="120" y="524" text-anchor="middle" class="aid-xs">weryfikator · adwokat diabła</text></g><g data-explain="branch-4"><path d="M550 87 C 480 87, 470 288, 380 288" class="aid-ln aid-thin"></path><rect x="550" y="36" width="180" height="102" rx="9" class="aid-box aid-side"></rect><text x="640" y="56" text-anchor="middle" class="aid-t">Doktryna</text><text x="640" y="74" text-anchor="middle" class="aid-xs">projekt przed kodem</text><text x="640" y="92" text-anchor="middle" class="aid-xs">„gotowe” wg poziomu ryzyka</text><text x="640" y="110" text-anchor="middle" class="aid-xs">170 blizn</text></g><g data-explain="branch-5"><path d="M550 221 C 480 221, 470 288, 380 288" class="aid-ln aid-thin"></path><rect x="550" y="170" width="180" height="102" rx="9" class="aid-box aid-side"></rect><text x="640" y="190" text-anchor="middle" class="aid-t">Szablon repo</text><text x="640" y="208" text-anchor="middle" class="aid-xs">CI + testy mutacyjne</text><text x="640" y="226" text-anchor="middle" class="aid-xs">parsowane granice</text><text x="640" y="244" text-anchor="middle" class="aid-xs">matryca QA · prywatność ·</text><text x="640" y="256" text-anchor="middle" class="aid-xs">runbook</text></g><g data-explain="branch-6"><path d="M550 355 C 480 355, 470 288, 380 288" class="aid-ln aid-thin"></path><rect x="550" y="304" width="180" height="102" rx="9" class="aid-box aid-side"></rect><text x="640" y="324" text-anchor="middle" class="aid-t">Rutyny</text><text x="640" y="342" text-anchor="middle" class="aid-xs">recenzent PR · kontrola</text><text x="640" y="354" text-anchor="middle" class="aid-xs">zdrowia</text><text x="640" y="372" text-anchor="middle" class="aid-xs">nadzór podatności</text><text x="640" y="390" text-anchor="middle" class="aid-xs">wstrzymane do naprawy</text></g><g data-explain="branch-7"><path d="M550 489 C 480 489, 470 288, 380 288" class="aid-ln aid-thin"></path><rect x="550" y="438" width="180" height="102" rx="9" class="aid-box aid-side"></rect><text x="640" y="458" text-anchor="middle" class="aid-t">Samotesty</text><text x="640" y="476" text-anchor="middle" class="aid-xs">każda bramka ma test</text><text x="640" y="494" text-anchor="middle" class="aid-xs">pokrycie reguła → bramka</text><text x="640" y="512" text-anchor="middle" class="aid-xs">cotygodniowy audyt</text></g><circle data-explain="center" cx="380" cy="288" r="64" class="aid-box aid-strong"></circle><text x="380" y="284" text-anchor="middle" class="aid-t aid-accent">WYŻSZY UMYSŁ</text><text x="380" y="302" text-anchor="middle" class="aid-xs">PG · PROMPT-GUARD</text><text x="380" y="570" text-anchor="middle" class="aid-xs">Osiem części, jedna zasada: nic ważnego nie istnieje tylko jako tekst. Każda reguła ma automatyczną kontrolę.</text></svg></div>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > pipe 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 272" class="aid" role="img" aria-label="Dziewięć punktów kontroli na drodze zmiany. Decyzje podejmuję ja; kontrole pilnują, żeby nic nie umknęło."><defs><marker id="aipr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" class="aid-arrowhead"></path></marker></defs><path d="M58 62 L672 62" class="aid-ln" marker-end="url(#aipr)"></path><rect data-explain="live" x="690" y="45" width="60" height="34" rx="8" class="aid-box aid-strong"></rect><text x="720" y="66" text-anchor="middle" class="aid-t aid-accent">LIVE</text><g data-explain="stage-0"><circle cx="78" cy="62" r="5" class="aid-node"></circle><text x="78" y="42" text-anchor="middle" class="aid-s aid-stage">prompt</text><path d="M78 70 L78 92" class="aid-ln aid-thin"></path><rect x="14.25" y="94" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="78" y="115.5" text-anchor="middle" class="aid-xs aid-chip-t">protokół w prompcie</text></g><g data-explain="stage-1"><circle cx="149.75" cy="62" r="5" class="aid-node"></circle><text x="149.75" y="28" text-anchor="middle" class="aid-s aid-stage">edycja</text><path d="M149.75 70 L149.75 144" class="aid-ln aid-thin"></path><rect x="86" y="146" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="149.75" y="167.5" text-anchor="middle" class="aid-xs aid-chip-t">lint + typy</text></g><g data-explain="stage-2"><circle cx="221.5" cy="62" r="5" class="aid-node"></circle><text x="221.5" y="42" text-anchor="middle" class="aid-s aid-stage">komenda</text><path d="M221.5 70 L221.5 92" class="aid-ln aid-thin"></path><rect x="157.75" y="94" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="221.5" y="115.5" text-anchor="middle" class="aid-xs aid-chip-t">strażnik + no-verify</text></g><g data-explain="stage-3"><circle cx="293.25" cy="62" r="5" class="aid-node"></circle><text x="293.25" y="28" text-anchor="middle" class="aid-s aid-stage">koniec sesji</text><path d="M293.25 70 L293.25 144" class="aid-ln aid-thin"></path><rect x="229.5" y="146" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="293.25" y="161" text-anchor="middle" class="aid-xs aid-chip-t">tier + testy</text><text x="293.25" y="174" text-anchor="middle" class="aid-xs aid-chip-t">+ recenzenci</text></g><g data-explain="stage-4"><circle cx="365" cy="62" r="5" class="aid-node"></circle><text x="365" y="42" text-anchor="middle" class="aid-s aid-stage">commit</text><path d="M365 70 L365 92" class="aid-ln aid-thin"></path><rect x="301.25" y="94" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="365" y="109" text-anchor="middle" class="aid-xs aid-chip-t">opis · sekrety ·</text><text x="365" y="122" text-anchor="middle" class="aid-xs aid-chip-t">zależności · SQL</text></g><g data-explain="stage-5"><circle cx="436.75" cy="62" r="5" class="aid-node"></circle><text x="436.75" y="28" text-anchor="middle" class="aid-s aid-stage">push</text><path d="M436.75 70 L436.75 144" class="aid-ln aid-thin"></path><rect x="373" y="146" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="436.75" y="161" text-anchor="middle" class="aid-xs aid-chip-t">bez main</text><text x="436.75" y="174" text-anchor="middle" class="aid-xs aid-chip-t">+ rozmiar + cykle</text></g><g data-explain="stage-6"><circle cx="508.5" cy="62" r="5" class="aid-node"></circle><text x="508.5" y="42" text-anchor="middle" class="aid-s aid-stage">CI</text><path d="M508.5 70 L508.5 92" class="aid-ln aid-thin"></path><rect x="444.75" y="94" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="508.5" y="115.5" text-anchor="middle" class="aid-xs aid-chip-t">mutacje + sekrety</text></g><g data-explain="stage-7"><circle cx="580.25" cy="62" r="5" class="aid-node"></circle><text x="580.25" y="28" text-anchor="middle" class="aid-s aid-stage">merge</text><path d="M580.25 70 L580.25 144" class="aid-ln aid-thin"></path><rect x="516.5" y="146" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="580.25" y="161" text-anchor="middle" class="aid-xs aid-chip-t">tylko aktualny</text><text x="580.25" y="174" text-anchor="middle" class="aid-xs aid-chip-t">merge-ref</text></g><g data-explain="stage-8"><circle cx="652" cy="62" r="5" class="aid-node"></circle><text x="652" y="42" text-anchor="middle" class="aid-s aid-stage">produkcja</text><path d="M652 70 L652 92" class="aid-ln aid-thin"></path><rect x="588.25" y="94" width="127.5" height="36" rx="7" class="aid-chip"></rect><text x="652" y="109" text-anchor="middle" class="aid-xs aid-chip-t">200 z prawdziwej</text><text x="652" y="122" text-anchor="middle" class="aid-xs aid-chip-t">domeny</text></g><text x="380" y="208" text-anchor="middle" class="aid-xs aid-red">✕ żadnego cichego omijania: bramkę jakości można przejść tylko z wpisem w dzienniku · ryzykowne kroki dopiero</text><text x="380" y="222" text-anchor="middle" class="aid-xs aid-red">po recenzji podagentów · kroki nieodwracalne i same bramki dopiero po moim „pozwol ALLOW_…” w czacie ·</text><text x="380" y="236" text-anchor="middle" class="aid-xs aid-red">rutynowy pull request scala się bez mojej frazy tylko z dowodem recenzji</text><text x="380" y="260" text-anchor="middle" class="aid-xs">Dziewięć punktów kontroli na drodze zmiany. Decyzje podejmuję ja; kontrole pilnują, żeby nic nie umknęło.</text></svg></div>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > release 1`] = `"<figure class="ch-fig"><ol class="rs-list"><li class="rs-step ch-tone-a"><span class="rs-n">1</span><span class="rs-title">build i testy</span><span class="rs-detail">kontrole, które przechodzi już każdy pull request</span></li><li class="rs-step ch-tone-a"><span class="rs-n">2</span><span class="rs-title">sondowanie podglądu</span><span class="rs-detail">automatyczne zapytania na ścieżkach, które nie mogą się zepsuć</span></li><li class="rs-step ch-tone-a"><span class="rs-n">3</span><span class="rs-title">10 minut czekania</span><span class="rs-detail">nowy build testowany poza ruchem, zanim domena się przełączy</span></li><li class="rs-step ch-tone-a"><span class="rs-n">4</span><span class="rs-title">15 minut obserwacji</span><span class="rs-detail">żywa strona sprawdzana co 30 sekund</span></li></ol><p class="rs-back">↺ <!-- -->trzy nieudane sprawdzenia z rzędu (około minuty) przywracają ostatnią dobrą wersję, raz; potem decyduje człowiek</p><figcaption class="aid-cap">Zaprojektowane i zrecenzowane; jeszcze nie przećwiczone na żywym projekcie.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > review 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 236" class="aid" role="img" aria-label="Recenzenci dostają tylko kod po kontrolach skryptowych. Uwagi łączy skrypt. Weryfikator szuka błędów, a nie potwierdzeń."><defs><marker id="airv" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" class="aid-arrowhead"></path></marker></defs><rect data-explain="orchestrator" x="16" y="70" width="128" height="48" rx="9" class="aid-box aid-strong"></rect><text x="80" y="98" text-anchor="middle" class="aid-t">ORKIESTRATOR</text><path d="M144 94 L176 94" class="aid-ln" marker-end="url(#airv)"></path><rect data-explain="gates" x="180" y="63" width="130" height="62" rx="9" class="aid-band"></rect><text x="245" y="85" text-anchor="middle" class="aid-t aid-accent">SKRYPTY</text><text x="245" y="103" text-anchor="middle" class="aid-xs">lint · typy · testy · SQL</text><g data-explain="finder-0"><path d="M310 94 L346 34" class="aid-ln aid-thin" marker-end="url(#airv)"></path><rect x="350" y="18" width="118" height="32" rx="7" class="aid-box aid-side"></rect><text x="409" y="39" text-anchor="middle" class="aid-s">kod</text><path d="M468 34 L504 94" class="aid-ln aid-thin" marker-end="url(#airv)"></path></g><g data-explain="finder-1"><path d="M310 94 L346 74" class="aid-ln aid-thin" marker-end="url(#airv)"></path><rect x="350" y="58" width="118" height="32" rx="7" class="aid-box aid-side"></rect><text x="409" y="79" text-anchor="middle" class="aid-s">bezpieczeństwo</text><path d="M468 74 L504 94" class="aid-ln aid-thin" marker-end="url(#airv)"></path></g><g data-explain="finder-2"><path d="M310 94 L346 114" class="aid-ln aid-thin" marker-end="url(#airv)"></path><rect x="350" y="98" width="118" height="32" rx="7" class="aid-box aid-side"></rect><text x="409" y="119" text-anchor="middle" class="aid-s">dane · operacje</text><path d="M468 114 L504 94" class="aid-ln aid-thin" marker-end="url(#airv)"></path></g><g data-explain="finder-3"><path d="M310 94 L346 154" class="aid-ln aid-thin" marker-end="url(#airv)"></path><rect x="350" y="138" width="118" height="32" rx="7" class="aid-box aid-side"></rect><text x="409" y="159" text-anchor="middle" class="aid-s">ux · produkt · qa</text><path d="M468 154 L504 94" class="aid-ln aid-thin" marker-end="url(#airv)"></path></g><rect data-explain="aggregate" x="508" y="66" width="112" height="56" rx="9" class="aid-box"></rect><text x="564" y="88" text-anchor="middle" class="aid-t">AGREGACJA</text><text x="564" y="106" text-anchor="middle" class="aid-xs">k-z-n · z dowodem</text><path d="M564 122 L564 148" class="aid-ln" marker-end="url(#airv)"></path><rect data-explain="verifier" x="508" y="152" width="112" height="48" rx="9" class="aid-box aid-strong"></rect><text x="564" y="172" text-anchor="middle" class="aid-t">WERYFIKATOR</text><text x="564" y="189" text-anchor="middle" class="aid-xs">odtwórz albo obal</text><path d="M620 94 L654 94" class="aid-ln" marker-end="url(#airv)"></path><rect data-explain="fixer" x="658" y="70" width="92" height="48" rx="9" class="aid-box aid-prod"></rect><text x="704" y="98" text-anchor="middle" class="aid-s aid-prod-t">FIX + BRAMKI</text><text x="380" y="216" text-anchor="middle" class="aid-xs aid-red">✕ <!-- -->zero czatu między agentami · uwaga bez wykonanej komendy się nie liczy</text><text x="380" y="231" text-anchor="middle" class="aid-xs">Recenzenci dostają tylko kod po kontrolach skryptowych. Uwagi łączy skrypt. Weryfikator szuka błędów, a nie potwierdzeń.</text></svg></div>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > rounds 1`] = `"<figure class="ch-fig"><div class="ch-legend"><span><i class="ch-key ch-tone-b"></i> <!-- -->blokujące</span><span><i class="ch-key ch-tone-a"></i> <!-- -->poważne</span></div><div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 230" class="aid" role="img" aria-label="Wydanie 1.7.0: uwagi w każdej rundzie recenzji. Rundy 1–6 prowadziło trzech albo czterech recenzentów; dwie kontrole końcowe poprawek dwóch. runda 1: 1 blokujące, 11 poważne; runda 2: 1 blokujące, 13 poważne; runda 3: 0 blokujące, 11 poważne; runda 4: 0 blokujące, 8 poważne; runda 5: 0 blokujące, 9 poważne; runda 6: 0 blokujące, 8 poważne; kontrole końcowe: 1 blokujące, 2 poważne."><line x1="60" x2="720" y1="180" y2="180" class="aid-ln"></line><g><title>runda 1: 1 blokujące, 11 poważne</title><rect x="77.71428571428572" y="49.428571428571416" width="56" height="117.85714285714286" rx="4" class="ch-svg-a"></rect><rect x="77.71428571428572" y="169.28571428571428" width="56" height="10.714285714285714" rx="4" class="ch-svg-b"></rect><text x="105.71428571428572" y="41.428571428571416" text-anchor="middle" class="aid-t">1 + 11</text><text x="105.71428571428572" y="200" text-anchor="middle" class="aid-s">runda 1</text></g><g><title>runda 2: 1 blokujące, 13 poważne</title><rect x="169.14285714285717" y="28" width="56" height="139.28571428571428" rx="4" class="ch-svg-a"></rect><rect x="169.14285714285717" y="169.28571428571428" width="56" height="10.714285714285714" rx="4" class="ch-svg-b"></rect><text x="197.14285714285717" y="20" text-anchor="middle" class="aid-t">1 + 13</text><text x="197.14285714285717" y="200" text-anchor="middle" class="aid-s">runda 2</text></g><g><title>runda 3: 0 blokujące, 11 poważne</title><rect x="260.57142857142856" y="62.14285714285714" width="56" height="117.85714285714286" rx="4" class="ch-svg-a"></rect><text x="288.57142857142856" y="54.14285714285714" text-anchor="middle" class="aid-t">11</text><text x="288.57142857142856" y="200" text-anchor="middle" class="aid-s">runda 3</text></g><g><title>runda 4: 0 blokujące, 8 poważne</title><rect x="352" y="94.28571428571429" width="56" height="85.71428571428571" rx="4" class="ch-svg-a"></rect><text x="380" y="86.28571428571429" text-anchor="middle" class="aid-t">8</text><text x="380" y="200" text-anchor="middle" class="aid-s">runda 4</text></g><g><title>runda 5: 0 blokujące, 9 poważne</title><rect x="443.42857142857144" y="83.57142857142857" width="56" height="96.42857142857143" rx="4" class="ch-svg-a"></rect><text x="471.42857142857144" y="75.57142857142857" text-anchor="middle" class="aid-t">9</text><text x="471.42857142857144" y="200" text-anchor="middle" class="aid-s">runda 5</text></g><g><title>runda 6: 0 blokujące, 8 poważne</title><rect x="534.8571428571428" y="94.28571428571429" width="56" height="85.71428571428571" rx="4" class="ch-svg-a"></rect><text x="562.8571428571428" y="86.28571428571429" text-anchor="middle" class="aid-t">8</text><text x="562.8571428571428" y="200" text-anchor="middle" class="aid-s">runda 6</text></g><g><title>kontrole końcowe: 1 blokujące, 2 poważne</title><rect x="626.2857142857142" y="145.85714285714286" width="56" height="21.428571428571427" rx="4" class="ch-svg-a"></rect><rect x="626.2857142857142" y="169.28571428571428" width="56" height="10.714285714285714" rx="4" class="ch-svg-b"></rect><text x="654.2857142857142" y="137.85714285714286" text-anchor="middle" class="aid-t">1 + 2</text><text x="654.2857142857142" y="200" text-anchor="middle" class="aid-s">kontrole końcowe</text></g></svg></div><figcaption class="aid-cap">Wydanie 1.7.0: uwagi w każdej rundzie recenzji. Rundy 1–6 prowadziło trzech albo czterech recenzentów; dwie kontrole końcowe poprawek dwóch.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > tiers 1`] = `"<figure class="ch-fig"><ol class="tl-list"><li class="tl-rung" data-explain="rung-0"><span class="tl-tier">T0</span><span class="tl-trigger">dokumentacja, teksty, style, zasoby</span><span class="tl-rev">tylko kontrole skryptowe</span><span class="tl-cost"><span class="tl-cost-t">koszt recenzji</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:0%"></span></span><span class="tl-cost-l">0 tokenów AI</span></span></li><li class="tl-rung" data-explain="rung-1"><span class="tl-tier">T1</span><span class="tl-trigger">jeden odizolowany komponent albo helper</span><span class="tl-rev">recenzja kodu zalecana</span><span class="tl-cost"><span class="tl-cost-t">koszt recenzji</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:11.11111111111111%"></span></span><span class="tl-cost-l">≈ 1 recenzja</span></span></li><li class="tl-rung" data-explain="rung-2"><span class="tl-tier">T2</span><span class="tl-trigger">wspólna logika, API, zależności, CI, &gt; 150 linii</span><span class="tl-rev">kod + operacje (+ UX, + dane)</span><span class="tl-cost"><span class="tl-cost-t">koszt recenzji</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:44.44444444444444%"></span></span><span class="tl-cost-l">≈ 4 recenzje</span></span></li><li class="tl-rung" data-explain="rung-3"><span class="tl-tier">T3</span><span class="tl-trigger">logowanie, uprawnienia, płatności, sekrety, migracje, cron, &gt; 600 linii</span><span class="tl-rev">kod + bezpieczeństwo + dane + operacje → weryfikator</span><span class="tl-cost"><span class="tl-cost-t">koszt recenzji</span><span class="ch-track"><span class="ch-bar ch-tone-a" style="width:100%"></span></span><span class="tl-cost-l">≈ 8–10 recenzji</span></span></li></ol><figcaption class="aid-cap">Poziom wynika ze ścieżek i rozmiaru zmiany, nigdy z polecenia. Bezpieczeństwo, dane i weryfikację przy T3 recenzuje najmocniejszy model.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > vault 1`] = `"<div class="aid-scroll" tabindex="0"><svg viewBox="0 0 760 148" class="aid" role="img" aria-label="Agent może użyć hasła lub klucza, którego nigdy nie zobaczy."><defs><marker id="aivr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" class="aid-arrowhead"></path></marker></defs><rect data-explain="vault" x="40" y="24" width="160" height="52" rx="9" class="aid-box aid-strong"></rect><text x="120" y="46" text-anchor="middle" class="aid-t">SEJF</text><text x="120" y="63" text-anchor="middle" class="aid-s">157 sekretów · self-hosted</text><path d="M200 50 L296 50" class="aid-ln" marker-end="url(#aivr)"></path><rect data-explain="bridge" x="300" y="24" width="150" height="52" rx="9" class="aid-box"></rect><text x="375" y="46" text-anchor="middle" class="aid-t">POŚREDNIK</text><text x="375" y="63" text-anchor="middle" class="aid-s">przekazuje do procesu</text><path d="M450 50 L546 50" class="aid-ln" marker-end="url(#aivr)"></path><rect data-explain="target" x="550" y="24" width="172" height="52" rx="9" class="aid-box"></rect><text x="636" y="46" text-anchor="middle" class="aid-t">PROCES DOCELOWY</text><text x="636" y="63" text-anchor="middle" class="aid-s">deploy · wywołanie API · CI</text><text data-explain="never" x="270" y="106" text-anchor="middle" class="aid-s aid-red">czat ✕</text><text data-explain="never" x="380" y="106" text-anchor="middle" class="aid-s aid-red">kod ✕</text><text data-explain="never" x="490" y="106" text-anchor="middle" class="aid-s aid-red">logi ✕</text><text x="380" y="134" text-anchor="middle" class="aid-xs">Agent może użyć hasła lub klucza, którego nigdy nie zobaczy.</text></svg></div>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > versions 1`] = `"<figure class="ch-fig"><div class="vt-strip" aria-hidden="true" style="grid-template-columns:repeat(33, minmax(0, 1fr))"><span class="vt-day on" title="1"></span><span class="vt-day on" title="1"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day on" title="1"></span><span class="vt-day on" title="6">6</span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day on" title="2">2</span><span class="vt-day on" title="1"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day on" title="1"></span><span class="vt-day on" title="1"></span><span class="vt-day"></span><span class="vt-day"></span><span class="vt-day on" title="1"></span></div><div class="vt-ticks" aria-hidden="true"><span style="left:0%">12 wrz</span><span style="left:59.375%">1 paź</span><span style="left:100%">14 paź</span></div><ol class="vt-list"><li><span class="vt-date">12 wrz</span><span class="vt-v">1.0.0</span><span class="vt-theme">pierwszy publiczny eksport Prompt-Guard</span></li><li><span class="vt-date">13 wrz</span><span class="vt-v">1.1.0</span><span class="vt-theme">pełny protokół po angielsku, dwujęzyczne blokady</span></li><li><span class="vt-date">27 wrz</span><span class="vt-v">1.2.0</span><span class="vt-theme">przebudowa po porównaniu z 35 projektami open source</span></li><li><span class="vt-date">28 wrz</span><span class="vt-v">1.2.1–1.2.6</span><span class="vt-theme">sześć poprawek: werdykt testów tylko z kodu wyjścia</span></li><li><span class="vt-date">5 paź</span><span class="vt-v">1.3.0</span><span class="vt-theme">pull requesty scalane z dowodem recenzji</span></li><li><span class="vt-date">5 paź</span><span class="vt-v">1.4.0</span><span class="vt-theme">te same zasady za mniejszy rachunek za kontekst</span></li><li><span class="vt-date">6 paź</span><span class="vt-v">1.5.0</span><span class="vt-theme">wiersz dla każdego obszaru projektowania systemów</span></li><li><span class="vt-date">10 paź</span><span class="vt-v">1.6.0</span><span class="vt-theme">rozszerzenia pod nadzorem, każda warstwa stacku</span></li><li><span class="vt-date">11 paź</span><span class="vt-v">1.7.0</span><span class="vt-theme">architektura podjęta na stałe, potok wydań</span></li><li><span class="vt-date">14 paź</span><span class="vt-v">1.8.0</span><span class="vt-theme">proporcjonalność, potem tryb utrzymania</span></li></ol><figcaption class="aid-cap">Pasek ma jedną komórkę na dzień; wypełniona komórka to wydanie, a liczba oznacza kilka wydań tego dnia.</figcaption></figure>"`;

exports[`/claude figures > pl > draws every figure exactly as last reviewed > waffle 1`] = `"<figure class="ch-fig"><div class="wf-grid" role="img" aria-label="aktywne w ostatnich 30 dniach: 12, skończone albo w spoczynku: 34, nigdy nie sprawdzane przez rutyny: 1"><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-a"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-n"></span><span class="wf-cell ch-tone-b"></span></div><ul class="sb-keys"><li><i class="ch-key ch-tone-a"></i> <!-- -->aktywne w ostatnich 30 dniach<!-- --> <b>12</b></li><li><i class="ch-key ch-tone-n"></i> <!-- -->skończone albo w spoczynku<!-- --> <b>34</b></li><li><i class="ch-key ch-tone-b"></i> <!-- -->nigdy nie sprawdzane przez rutyny<!-- --> <b>1</b></li></ul><div class="wf-facts"><span class="wf-fact"><b>33</b> <!-- -->z ochroną gałęzi, w tym 31 ścisłą</span><span class="wf-fact"><b>44</b> <!-- -->z włączonymi alertami podatności GitHuba</span></div><figcaption class="aid-cap">Jeden kwadrat to jedno repozytorium; policzone z GitHuba 14 października 2026.</figcaption></figure>"`;
